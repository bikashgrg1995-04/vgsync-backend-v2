# Copy this file to .env and fill in the values.
# Never commit the real .env file.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=vgsync
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# CORS: comma-separated frontend origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:4321

# Redis cache shared by all worker processes (used for rate limiting).
# Leave empty in development to use a local in-memory cache.
# Production example: REDIS_URL=redis://localhost:6379/1
REDIS_URL=

# Number of reverse proxies in front of the app (0 = none, 1 = e.g. nginx).
# Used to find the real client IP for rate limiting.
NUM_PROXIES=0

# Password reset emails. The link in the email points at FRONTEND_URL.
# With EMAIL_HOST empty, emails are printed to the server console.
FRONTEND_URL=http://localhost:4321
PASSWORD_RESET_TIMEOUT=3600
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=VGSync <no-reply@example.com>

# Help & Support page contact details (optional; these are the defaults).
# The guide and video links are hidden on the page while they are empty.
SUPPORT_EMAIL=support@vgsync.com
SUPPORT_PHONE=+977-1-5901234
SUPPORT_HOURS=Mon - Sat, 9AM - 6PM
SUPPORT_REPLY_TIME=We'll reply within 24 hours
SUPPORT_USER_GUIDE_URL=
SUPPORT_VIDEO_TUTORIALS_URL=
