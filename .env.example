# Copy this file to .env and fill in the values.
# Never commit the real .env file.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=vgsync
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# CORS: comma-separated frontend origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Redis cache shared by all worker processes (used for rate limiting).
# Leave empty in development to use a local in-memory cache.
# Production example: REDIS_URL=redis://localhost:6379/1
REDIS_URL=

# Number of reverse proxies in front of the app (0 = none, 1 = e.g. nginx).
# Used to find the real client IP for rate limiting.
NUM_PROXIES=0
